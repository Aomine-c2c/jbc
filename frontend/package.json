{
  "name": "frontend",
  "version": "2.10.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:backend": "cd ../backend && ../.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload 2>/dev/null || .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:full": "concurrently --names \"backend,frontend\" --prefix-colors \"cyan,magenta\" \"cd ../backend && .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload\" \"next dev\"",
    "build": "next build",
    "build:export": "node -e \"process.env.NEXT_EXPORT='true'; const { spawnSync } = require('child_process'); const res = spawnSync('next', ['build'], { stdio: 'inherit', env: { ...process.env, NEXT_EXPORT: 'true' }, shell: true }); process.exit(res.status || 0);\"",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "concurrently \"npm run dev:backend\" \"npm run dev\" \"tauri dev\"",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@types/animejs": "^3.1.13",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
