# ==============================================================================
# BIKITA MINERALS DWRMS — STAGING ENVIRONMENT CONFIGURATION
# ==============================================================================
ENVIRONMENT=staging
DEBUG=false
APP_NAME="Bikita Minerals DWRMS (Staging)"
APP_VERSION=v1.9.0-rc1

SECRET_KEY=staging_secret_key_change_regularly_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=3

FRONTEND_URL=https://staging-dwrms.bikita.com
NEXT_PUBLIC_API_URL=https://staging-dwrms.bikita.com/api/v1
CORS_ORIGINS=https://staging-dwrms.bikita.com,http://localhost:3000,tauri://localhost

DB_ENGINE=postgresql
DB_HOST=db-staging
DB_PORT=5432
DB_USER=dwrms_staging
DB_PASSWORD=staging_db_password_123
DB_NAME=dwrms_staging
POSTGRES_USER=dwrms_staging
POSTGRES_PASSWORD=staging_db_password_123
POSTGRES_DB=dwrms_staging

REDIS_URL=redis://redis-staging:6379/0
CELERY_BROKER_URL=redis://redis-staging:6379/0
CELERY_RESULT_BACKEND=redis://redis-staging:6379/0

STORAGE_PATH=/var/dwrms/storage-staging
LOG_DIR=/var/dwrms/logs-staging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

DOCKER_REGISTRY=dwrms
IMAGE_TAG=staging-latest
