#!/usr/bin/env python3
"""
Bikita Minerals DWRMS — Authoritative Platform Administration Command.
Usage:
    ops --help
    ops setup
    ops install
    ops configure list
    ops status
    ops health
    ops logs -s app -n 50
    ops diagnostics
    ops backup create
    ops backup list
    ops restore <backup_name>
    ops users list
    ops network
    ops server start|stop|restart|reload
    ops update
"""
import os
import sys
from pathlib import Path

# Add backend directory to sys.path
root_dir = Path(__file__).resolve().parent
backend_dir = root_dir / "backend"

if str(backend_dir) not in sys.path:
    sys.path.insert(0, str(backend_dir))

# Automatically load .env if present and not yet loaded
env_file = root_dir / ".env"
if not env_file.exists():
    env_file = backend_dir / ".env"

if env_file.exists():
    os.environ.setdefault("DWRMS_ENV_FILE", str(env_file))

from app.cli.main import ops_group

if __name__ == "__main__":
    ops_group()
