# ==============================================================================
# BIKITA MINERALS DWRMS — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
ENVIRONMENT=production
DEBUG=false
APP_NAME="Bikita Minerals DWRMS"
APP_VERSION=v1.9.0

# Mandatory: Generate with `openssl rand -hex 32`
SECRET_KEY=generate_production_32_byte_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Authoritative URLs
FRONTEND_URL=https://dwrms.bikita.com
NEXT_PUBLIC_API_URL=https://dwrms.bikita.com/api/v1
CORS_ORIGINS=https://dwrms.bikita.com,tauri://localhost,http://tauri.localhost

# Database Configuration (PostgreSQL 16)
DB_ENGINE=postgresql
DB_HOST=db
DB_PORT=5432
DB_USER=dwrms_prod
DB_PASSWORD=replace_with_hardened_production_db_password
DB_NAME=dwrms
POSTGRES_USER=dwrms_prod
POSTGRES_PASSWORD=replace_with_hardened_production_db_password
POSTGRES_DB=dwrms
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis & Celery Stack
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage & Logging Paths (mounted as Docker persistent volumes)
STORAGE_PATH=/var/dwrms/storage
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,webp,xlsx,docx,csv,txt
LOG_DIR=/var/dwrms/logs
LOG_LEVEL=INFO
LOG_FORMAT=json

# Container registry image tag
DOCKER_REGISTRY=dwrms
IMAGE_TAG=v1.9.0
