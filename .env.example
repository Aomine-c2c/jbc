# ==============================================================================
# Bikita Minerals DWRMS — Environment Configuration Template
# Copy this file to `.env` in the project root on your target machine.
# ==============================================================================

# Platform & Branding
SETUP_COMPLETED="true"
APP_NAME="Bikita Minerals DWRMS"
SERVER_NAME="bikita-srv-01"
# Options: development, testing, staging, production
# Use 'testing' or 'development' for local dev (enables demo password fallback)
ENVIRONMENT="testing"
TIMEZONE="Africa/Harare"

# Frontend & Backend Network Endpoints
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# CORS Allowed Origins (Comma-separated)
# Include localhost, local LAN IPs, and Tauri origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost"

# Database Configuration
# Options for DB_ENGINE: "sqlite" (default for local dev), "postgresql"
DB_ENGINE="sqlite"
DB_NAME="test.db"
DB_HOST="localhost"
# DB_PORT, DB_USER, and DB_PASSWORD are only used for PostgreSQL
# DB_PORT="5432"
# DB_USER=""
# DB_PASSWORD=""

# File Storage & Backups
STORAGE_PATH="./storage"
MAX_UPLOAD_SIZE_MB="25"
BACKUP_DIR="./backups"
RETENTION_DAYS="30"

# Remote Connectivity (Provider-Agnostic)
DEPLOYMENT_MODE="LOCAL_ONLY"  # LOCAL_ONLY, HYBRID_REMOTE, PRIVATE_DISTRIBUTED
REMOTE_CONNECTIVITY_ENABLED=false
REMOTE_NETWORK_PROVIDER="none"  # none, tailscale, wireguard, custom_vpn, zero_trust

# Platform Versioning
MIN_SUPPORTED_CLIENT_VERSION="v2.0.0"
UPDATE_CHANNEL="enterprise_lts"

# Security (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
# REQUIRED: Must be set. A default dev key is used only if left blank AND ENVIRONMENT is not 'production'.
SECRET_KEY=dev-changeme-please-set-a-real-secret-in-production
