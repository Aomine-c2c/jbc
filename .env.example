# ==============================================================================
# Bikita Minerals DWRMS — Environment Configuration Template
# Copy this file to `.env` in the project root on your target machine.
# ==============================================================================

# Platform & Branding
SETUP_COMPLETED="true"
APP_NAME="Bikita Minerals DWRMS"
SERVER_NAME="bikita-srv-01"
ENVIRONMENT="production"
TIMEZONE="Africa/Harare"

# Frontend & Backend Network Endpoints
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# CORS Allowed Origins (Comma-separated)
# Include localhost, local LAN IPs, and Tauri origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost"

# Database Configuration
# Options for DB_ENGINE: "sqlite" (default local), "postgresql", "mysql"
DB_ENGINE="sqlite"
DB_NAME="test.db"
DB_HOST="localhost"
DB_PORT="5432"
DB_USER=""
DB_PASSWORD=""

# File Storage & Backups
STORAGE_PATH="./storage"
MAX_UPLOAD_SIZE_MB="25"
BACKUP_DIR="./backups"
RETENTION_DAYS="30"

# Security (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY="2213cd651769faeead10b80aa93ccb6f5724ca1f67053b2a9de68b54d43929e1"
