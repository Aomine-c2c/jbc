# ==============================================================================
# BIKITA MINERALS DWRMS — ENVIRONMENT CONFIGURATION TEMPLATE
# Platform Version: V1.9 (Authoritative Ubuntu Server Core)
# ==============================================================================

# ── 1. PLATFORM & ENVIRONMENT ────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
APP_NAME="Bikita Minerals DWRMS"
APP_VERSION=v1.9.0

# ── 2. SECURITY & AUTHENTICATION ─────────────────────────────────────────────
# Generate a secure 32-byte key: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_32_byte_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth method: LOCAL or LDAP
AUTH_METHOD=LOCAL
LDAP_SERVER_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE_DN=

# ── 3. AUTHORITATIVE DOMAINS & CORS ──────────────────────────────────────────
# The primary external URL accessed by clients
FRONTEND_URL=https://dwrms.bikita.com
NEXT_PUBLIC_API_URL=https://dwrms.bikita.com/api/v1

# Comma-separated list of allowed client origins for CORS
CORS_ORIGINS=https://dwrms.bikita.com,http://localhost:3000,tauri://localhost,http://tauri.localhost

# ── 4. RELATIONAL DATABASE (POSTGRESQL / MYSQL) ──────────────────────────────
# Supported engines: postgresql or mysql
DB_ENGINE=postgresql
DB_HOST=db
DB_PORT=5432
DB_USER=dwrms_user
DB_PASSWORD=your_secure_db_password_here
DB_NAME=dwrms
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Optional direct URI override (e.g. postgresql+asyncpg://user:pass@host:5432/dbname)
DATABASE_URL=

# ── 5. REDIS & BACKGROUND WORKER ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── 6. PERSISTENT STORAGE & ATTACHMENTS ───────────────────────────────────────
STORAGE_PATH=/var/dwrms/storage
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,webp,xlsx,docx,csv,txt

# ── 7. LOGGING & DIAGNOSTICS ─────────────────────────────────────────────────
LOG_DIR=/var/dwrms/logs
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── 8. DOCKER & CONTAINER REGISTRY ───────────────────────────────────────────
DOCKER_REGISTRY=dwrms
IMAGE_TAG=latest
