[
  {
    "id": "github-deploy",
    "execute-command": "/var/dwrms/repo/infrastructure/scripts/update.sh",
    "command-working-directory": "/var/dwrms/repo",
    "response-message": "Deploy triggered.",
    "trigger-rule": {
      "match": {
        "type": "value",
        "value": "refs/heads/main",
        "parameter": {
          "source": "payload",
          "name": "ref"
        }
      }
    }
  }
]
