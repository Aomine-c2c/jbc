[
  {
    "id": "github-deploy",
    "execute-command": "/var/dwrms/repo/infrastructure/scripts/update.sh",
    "command-working-directory": "/var/dwrms/repo",
    "response-message": "Deploy triggered.",
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hash-sha256",
            "secret": "{{ getenv \"WEBHOOK_SECRET\" }}",
            "parameter": {
              "source": "header",
              "name": "X-Hub-Signature-256"
            }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "refs/heads/main",
            "parameter": {
              "source": "payload",
              "name": "ref"
            }
          }
        }
      ]
    }
  }
]
