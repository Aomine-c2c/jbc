#!/usr/bin/env python3
"""
Bikita Minerals DWRMS — Authoritative Platform Administration Command.
Usage:
    ops --help
    ops setup
    ops install
    ops configure list
    ops status
    ops health
    ops logs -s app -n 50
    ops diagnostics
    ops backup create
    ops backup list
    ops restore <backup_name>
    ops users list
    ops network
    ops server start|stop|restart|reload
    ops update
"""
import os
import sys
import subprocess
from pathlib import Path

# Add backend directory to sys.path
root_dir = Path(__file__).resolve().parent.parent.parent  # scripts/ops/ -> project root
backend_dir = root_dir / "backend"
venv_python = backend_dir / ".venv" / "bin" / "python"
if os.name == "nt":
    venv_python = backend_dir / ".venv" / "Scripts" / "python.exe"

# Re-exec with virtual environment python if it exists and we are not using it
if venv_python.exists() and sys.executable != str(venv_python):
    os.execl(str(venv_python), str(venv_python), *sys.argv)

if str(backend_dir) not in sys.path:
    sys.path.insert(0, str(backend_dir))

# Automatically load .env if present and not yet loaded
env_file = root_dir / ".env"
if not env_file.exists():
    env_file = backend_dir / ".env"

if env_file.exists():
    os.environ.setdefault("DWRMS_ENV_FILE", str(env_file))

# Check if local Python environment has CLI dependencies
can_run_locally = False
try:
    import click
    from app.cli.main import ops_group
    can_run_locally = True
except ImportError:
    can_run_locally = False

if can_run_locally:
    if __name__ == "__main__":
        ops_group()
    sys.exit(0)
elif os.environ.get("DOCKER_ENV") != "true":
    # If no local virtual environment, delegate command to Docker backend container
    print("[INFO] No local virtual environment found. Delegating command to Docker backend container...")
    compose_file = root_dir / "docker-compose.prod.yml"
    if not compose_file.exists():
        compose_file = root_dir / "infrastructure" / "docker-compose.prod.yml"
    if not compose_file.exists():
        compose_file = root_dir / "infrastructure" / "docker-compose.yml"

    docker_bin = ["docker"]
    if os.name != "nt" and hasattr(os, "geteuid") and os.geteuid() != 0:
        res = subprocess.run(["docker", "ps"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if res.returncode != 0:
            docker_bin = ["sudo", "docker"]

    cmd = docker_bin + [
        "compose",
        "--project-directory", str(root_dir),
    ]
    if env_file.exists():
        cmd += ["--env-file", str(env_file)]
    cmd += [
        "-f", str(compose_file),
        "run", "--rm", "backend",
        "python", "-m", "app.cli.main"
    ] + sys.argv[1:]

    try:
        sys.exit(subprocess.call(cmd))
    except Exception as e:
        print(f"[ERROR] Failed to run command via Docker: {e}")
        sys.exit(1)
